# --- App ---
ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8081,exp://192.168.1.10:8081

# --- Database ---
DATABASE_URL=postgresql+psycopg2://hostdost:hostdost@localhost:5432/hostdost

# --- Clerk (auth) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=

# --- Telegram ---
# Create a bot via @BotFather, then set its webhook to POST {API}/webhooks/telegram
# with this same secret as the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Push (Expo/FCM) ---
EXPO_ACCESS_TOKEN=
