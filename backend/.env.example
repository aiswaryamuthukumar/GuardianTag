# ===== REQUIRED =====

# PostgreSQL connection. With the bundled docker-compose.yml (run `docker compose up -d` in the repo root)
# this exact value works. For your own local PostgreSQL, change user/password/database to match.
DATABASE_URL=postgresql+psycopg2://guardiantag:guardiantag@localhost:5433/guardiantag

# Signs login tokens. At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Code hostel staff type on the app's "Hostel staff" register tab. Share it only with wardens.
STAFF_INVITE_CODE=

# ===== OPTIONAL =====

ENV=development
API_V1_PREFIX=/api/v1
# Only matters for the web build; phones don't send an Origin header.
CORS_ORIGINS=http://localhost:8081
# How long a login lasts before the app asks to sign in again.
ACCESS_TOKEN_DAYS=7

# Telegram alerts: create a bot with @BotFather, then set its webhook to
# POST {API}/api/v1/webhooks/telegram with this secret as X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Expo push (only needed if you enabled push security on your Expo account)
EXPO_ACCESS_TOKEN=

# Background monitor
MONITOR_ENABLED=true
ESCALATION_SECONDS=30
OFFLINE_AFTER_SECONDS=180
APP_TIMEZONE=Asia/Kolkata

# In-app Demo Controls (simulate a trigger, heartbeat, offline device). Disable for a real deployment.
DEMO_TOOLS_ENABLED=true

# Uploaded photos
UPLOAD_DIR=uploads
