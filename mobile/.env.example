# The only required value: your computer's LAN IP so a phone on the same Wi-Fi can reach the backend.
# Find it with `ipconfig` (IPv4 Address). Use http://localhost:8000/api/v1 only for the web preview.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1
# Optional: derived from the API URL (ws://<host>/ws) when unset.
EXPO_PUBLIC_WS_URL=
